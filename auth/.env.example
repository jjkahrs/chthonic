# Copy to .env and adjust. docker compose reads this file; npm scripts and tests do too.
# Values below are for local development only.

# --- HTTP ---
PORT=3000
# Express "trust proxy" setting: false | true | hop count | comma-separated subnets.
# Set it when running behind a load balancer so per-IP rate limits see the real client IP.
TRUST_PROXY=false
# Base URL of the page that handles email links (verify-email / reset-password).
APP_BASE_URL=http://localhost:3000
# docker-compose only: host interface and port the auth container publishes. Default 127.0.0.1 (this machine only);
# 0.0.0.0 exposes auth to the network (needed for game clients on other machines) - only with non-placeholder secrets.
AUTH_BIND=127.0.0.1
AUTH_HOST_PORT=3000

# --- MySQL ---
# DB_HOST/SMTP_HOST are used from the host (npm run dev / npm test).
# docker-compose overrides them with the service names inside the network.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chthonic_auth
DB_PASSWORD=change-me-db
DB_NAME=chthonic_auth
# Database used by `npm test`. Created by docker/mysql-init.sh on a fresh volume.
TEST_DB_NAME=chthonic_auth_test
# Only used by the mysql container.
MYSQL_ROOT_PASSWORD=change-me-root
# Host port the mysql container publishes (on 127.0.0.1 only).
MYSQL_PORT=3306

# --- SMTP (Mailpit in development) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Chthonic <no-reply@chthonic.local>
# Host ports the mailpit container publishes (web UI/API and SMTP, on 127.0.0.1 only).
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- JWT ---
JWT_ISSUER=chthonic-auth
JWT_AUDIENCE=chthonic
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
# Production: provide the RS256 private key (PKCS#8 PEM) inline or as a mounted file.
# If neither is set, a dev keypair is generated in KEYS_DIR and reused on later starts.
JWT_PRIVATE_KEY=
JWT_PRIVATE_KEY_FILE=
# Optional key id; defaults to the RFC 7638 thumbprint of the public key.
JWT_KID=
KEYS_DIR=./keys

# --- Seed admin (created once, pre-verified; leave both empty to skip) ---
# auth refuses to start while SEED_ADMIN_PASSWORD is still a change-me placeholder: change it (or empty both).
SEED_ADMIN_EMAIL=admin@chthonic.local
SEED_ADMIN_PASSWORD=change-me-admin-password
